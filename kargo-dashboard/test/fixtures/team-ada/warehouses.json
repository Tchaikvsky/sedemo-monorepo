{
  "items": [
    {
      "metadata": {
        "name": "akkoma-main"
      },
      "spec": {
        "subscriptions": [
          {
            "chart": {
              "discoveryLimit": 20,
              "repoURL": "oci://ghcr.io/adamancini/charts/akkoma",
              "semverConstraint": ">=0.0.0-0 <0.0.1-0"
            }
          },
          {
            "image": {
              "allowTagsRegexes": [
                "^main-[0-9]{14}-[0-9a-f]{8}$"
              ],
              "discoveryLimit": 20,
              "imageSelectionStrategy": "Lexical",
              "repoURL": "ghcr.io/adamancini/akkoma",
              "strictSemvers": true
            }
          }
        ],
        "freightCreationPolicy": "Automatic",
        "freightCreationCriteria": {
          "expression": "chartFrom('oci://ghcr.io/adamancini/charts/akkoma').Version ==\n  '0.0.0-main.' + replace(trimPrefix(imageFrom('ghcr.io/adamancini/akkoma').Tag, 'main-'), '-', '.g')\n"
        }
      }
    },
    {
      "metadata": {
        "name": "akkoma-release"
      },
      "spec": {
        "subscriptions": [
          {
            "chart": {
              "discoveryLimit": 20,
              "repoURL": "oci://ghcr.io/adamancini/charts/akkoma",
              "semverConstraint": ">=0.6.0"
            }
          },
          {
            "image": {
              "allowTagsRegexes": [
                "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
              ],
              "constraint": ">=3.0.0",
              "discoveryLimit": 20,
              "imageSelectionStrategy": "SemVer",
              "repoURL": "ghcr.io/adamancini/akkoma",
              "strictSemvers": true
            }
          }
        ],
        "freightCreationPolicy": "Automatic"
      }
    }
  ]
}