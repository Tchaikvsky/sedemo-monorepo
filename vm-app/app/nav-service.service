[Unit]
Description=Fund NAV pricing service (nav-service)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=nav
Group=nav
ExecStart=/usr/local/bin/nav-service --config /etc/nav-service/config.yaml
Restart=on-failure
RestartSec=2
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
